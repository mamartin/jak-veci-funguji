{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/:slug(zamek|lednicka|mikrovlnka|var-vody|termoska|splachovani)",
      "destination": "/domacnost/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(zamek|lednicka|mikrovlnka|var-vody|termoska|splachovani)/",
      "destination": "/domacnost/:slug/",
      "permanent": true
    },
    {
      "source": "/clanky/:slug(zamek|lednicka|mikrovlnka|var-vody|termoska|splachovani)",
      "destination": "/domacnost/:slug/",
      "permanent": true
    },
    {
      "source": "/clanky/:slug(zamek|lednicka|mikrovlnka|var-vody|termoska|splachovani)/",
      "destination": "/domacnost/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(gps|qr-kod|carovy-kod|wifi|bluetooth|dotykovy-displej|lcd-oled|fotak|komprese-obrazku|potlaceni-hluku|scitani)",
      "destination": "/technika/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(gps|qr-kod|carovy-kod|wifi|bluetooth|dotykovy-displej|lcd-oled|fotak|komprese-obrazku|potlaceni-hluku|scitani)/",
      "destination": "/technika/:slug/",
      "permanent": true
    },
    {
      "source": "/clanky/:slug(gps|qr-kod|carovy-kod|wifi|bluetooth|dotykovy-displej|lcd-oled|fotak|komprese-obrazku|potlaceni-hluku|scitani)",
      "destination": "/technika/:slug/",
      "permanent": true
    },
    {
      "source": "/clanky/:slug(gps|qr-kod|carovy-kod|wifi|bluetooth|dotykovy-displej|lcd-oled|fotak|komprese-obrazku|potlaceni-hluku|scitani)/",
      "destination": "/technika/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(abs|prehazovacka|diferencial|motor|zacpa|zelena-vlna|letadlo|plachetnice|ponorka|mosty)",
      "destination": "/doprava/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(abs|prehazovacka|diferencial|motor|zacpa|zelena-vlna|letadlo|plachetnice|ponorka|mosty)/",
      "destination": "/doprava/:slug/",
      "permanent": true
    },
    {
      "source": "/clanky/:slug(abs|prehazovacka|diferencial|motor|zacpa|zelena-vlna|letadlo|plachetnice|ponorka|mosty)",
      "destination": "/doprava/:slug/",
      "permanent": true
    },
    {
      "source": "/clanky/:slug(abs|prehazovacka|diferencial|motor|zacpa|zelena-vlna|letadlo|plachetnice|ponorka|mosty)/",
      "destination": "/doprava/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(modre-nebe|blesk|duha|zemetreseni|letokruhy)",
      "destination": "/priroda/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(modre-nebe|blesk|duha|zemetreseni|letokruhy)/",
      "destination": "/priroda/:slug/",
      "permanent": true
    },
    {
      "source": "/clanky/:slug(modre-nebe|blesk|duha|zemetreseni|letokruhy)",
      "destination": "/priroda/:slug/",
      "permanent": true
    },
    {
      "source": "/clanky/:slug(modre-nebe|blesk|duha|zemetreseni|letokruhy)/",
      "destination": "/priroda/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(kychani|oko|barevne-videni|sluch|reflex|husi-kuze|dedicnost)",
      "destination": "/lidske-telo/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(kychani|oko|barevne-videni|sluch|reflex|husi-kuze|dedicnost)/",
      "destination": "/lidske-telo/:slug/",
      "permanent": true
    },
    {
      "source": "/clanky/:slug(kychani|oko|barevne-videni|sluch|reflex|husi-kuze|dedicnost)",
      "destination": "/lidske-telo/:slug/",
      "permanent": true
    },
    {
      "source": "/clanky/:slug(kychani|oko|barevne-videni|sluch|reflex|husi-kuze|dedicnost)/",
      "destination": "/lidske-telo/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(faze-mesice|priliv|beztize)",
      "destination": "/vesmir/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(faze-mesice|priliv|beztize)/",
      "destination": "/vesmir/:slug/",
      "permanent": true
    },
    {
      "source": "/clanky/:slug(faze-mesice|priliv|beztize)",
      "destination": "/vesmir/:slug/",
      "permanent": true
    },
    {
      "source": "/clanky/:slug(faze-mesice|priliv|beztize)/",
      "destination": "/vesmir/:slug/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
